[Unit]
Description=GHP - GitHub Proxy for Autonomous Coding Agents
Documentation=https://github.com/goodtune/ghp
After=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/ghp serve --migrate --config /etc/ghp/config.yaml
ExecReload=/bin/kill -USR1 $MAINPID

DynamicUser=yes
StateDirectory=ghp
ConfigurationDirectory=ghp
LogsDirectory=ghp
# Relative on-disk defaults (cache.storage_path "cache", webhooks.nats.store_dir
# "nats") resolve under the writable state directory rather than "/", which
# ProtectSystem=strict makes read-only.
WorkingDirectory=%S/ghp

Restart=on-failure
RestartSec=5s

# Security hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
